# AisStream Ingestion
AISSTREAM_API_KEY = your-api-key
AISSTREAM_BOUNDING_BOXES = [[[1.0,103.0],[5.0,106.0]]]
AISSTREAM_FILTER_MESSAGE_TYPES = ["PositionReport"]

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=ais.raw
KAFKA_TOPIC_DLQ=ais.dlq
KAFKA_PARTITIONS=8
KAFKA_CONSUMER_GROUP=raw-sink
KAFKA_CONSUMER_GROUP_STATE=realtime-state
POSTGRES_URL=postgresql://maritime:maritime@localhost:5433/maritime

# Ingest timestamp skew gate (DLQ)
INGEST_FUTURE_SKEW_TOLERANCE_SECONDS=60
INGEST_STALE_SKEW_TOLERANCE_SECONDS=21600

# Stream processor flush
STATE_FLUSH_ROWS=500
STATE_FLUSH_SECONDS=5
STATE_STALE_MINUTES=45

# Cleanup jobs
TRACK_RETENTION_HOURS=24
STATE_PURGE_AFTER_HOURS=0
S3_RETENTION_DAYS=7
S3_LIFECYCLE_ON=false
CLEANUP_INTERVAL_SECONDS=300

# S3 / MinIO
S3_BUCKET=maritime-raw
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PREFIX=raw

# Parquet buffering
PARQUET_MAX_ROWS=1000
PARQUET_MAX_SECONDS=900
PARQUET_MIN_ROWS=100

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
TRACK_WINDOW_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:4173