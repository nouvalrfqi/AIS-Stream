[Unit]
Description=Maritime Tracking API (FastAPI/uvicorn)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=<ROOT>
EnvironmentFile=<ROOT>/.env.systemd
ExecStart="<ROOT>/venv/bin/uvicorn" api.main:app --host 127.0.0.1 --port ${API_PORT}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maritime-api

[Install]
WantedBy=multi-user.target