[Unit]
Description=Maritime Cleanup (PostGIS retention + S3 lifecycle)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=<ROOT>
EnvironmentFile=<ROOT>/.env.systemd
ExecStart="<ROOT>/venv/bin/python" -m cleanup.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=maritime-cleanup

[Install]
WantedBy=multi-user.target